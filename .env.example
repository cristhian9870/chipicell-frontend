# Example environment variables for TodoApp-backend
PORT=3000
JWT_SECRET=your_jwt_secret_here
# FRONTEND_URL or FRONTEND_URLS (comma separated). Example:
FRONTEND_URL=http://localhost:5173
# OR
# FRONTEND_URLS=http://localhost:5173,http://localhost:3000
# If you serve a static build from the backend, set this to that folder
# FRONTEND_BUILD_PATH=./public
